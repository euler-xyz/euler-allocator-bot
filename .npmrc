audit-level=high
engine-strict=true
save-exact=true
fund=false

# Block installs of packages published less than 7 days ago.
# Mitigates supply-chain risk from typosquatting, compromised maintainers, and yanked releases.
# Value is in minutes (10080 = 7 days). Requires pnpm >=9.7 — currently pnpm@8 in packageManager,
# so this key is read but not enforced until pnpm is bumped.
minimum-release-age=10080
